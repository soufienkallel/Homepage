# Template for .env, the only env file of this repo (git-ignored): copy it to .env, fill in the
# secrets, then `npm run env:local` points it at the local Supabase stack. See docs/dev-local.md.
# Production values live in the Vercel project settings, not in a file.

# ─── Server-only (Vercel Functions in api/*) — never prefix with VITE_ ─────────
# Supabase (service role bypasses RLS: keep it server-side only)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=...

# Anthropic — chatbot (api/chat) and marketing/sales agents (api/agents/*)
ANTHROPIC_API_KEY=...
# Optional model overrides (defaults are set in server/agents/shared/claude-client.ts)
ANTHROPIC_MODEL_CHATBOT=
ANTHROPIC_MODEL_DRAFT=
ANTHROPIC_MODEL_RETRY=
# Salt for hashing visitor IPs in the chatbot rate limiter
RATE_LIMIT_SALT=change-me
# Marketing agent limits
AGENT_DAILY_DRAFT_CAP=50
AGENT_VALIDATE_IMAGES=false
# Demo booking link used in sales drafts
CAL_COM_DEMO_URL=https://calendar.zoho.com/zc/view/slot-booking/zz08011220ffb6cf75cb62a5e4811b76cf2ae7ed1fa19cdea04f9e14b8c2f8a7f24dd480c6
# Sent by Vercel Cron as "Authorization: Bearer <CRON_SECRET>" (weekly marketing run)
CRON_SECRET=...

# Deploy hook of the production branch (Vercel > Settings > Git > Deploy Hooks). Called by
# /api/admin/redeploy when a guide is published, so its pre-rendered page follows. Secret.
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
# Optional, build only: Chrome used by scripts/prerender.mjs off Vercel (found automatically
# on Windows and macOS); PRERENDER_STRICT=1 fails the build when pre-rendering fails.
# PRERENDER_CHROME_PATH=
# PRERENDER_STRICT=1

# Newsletter double opt-in (api/newsletter/*)
MJ_APIKEY_PUBLIC=...
MJ_APIKEY_PRIVATE=...
MJ_LIST_ID=...
MJ_SENDER_EMAIL=newsletter@mallouliauto.com
MJ_SENDER_NAME=MALLOULIAUTO
PUBLIC_SITE_URL=http://localhost:3000

# E-mail to the team for each new request (api/contact-requests), sent with the MJ_* keys above.
# Without them no e-mail is sent; the request is still stored.
# Optional. Sender: a sender validated in Mailjet (default notifications@mallouliauto.com).
# Recipient: default info@mallouliauto.com.
REQUEST_NOTIFY_FROM=
REQUEST_NOTIFY_TO=

# Local tooling only — lets curl/tests reach protected preview deployments
# (header `x-vercel-protection-bypass`). Vercel sets it on its own deployments: never add it
# to the project's environment variables. Value: Project Settings → Deployment Protection →
# Protection Bypass for Automation.
VERCEL_AUTOMATION_BYPASS_SECRET=

# ─── Browser (bundled into the public site — nothing secret here) ─────────────
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=...
# Leave empty: under `vercel dev` (and in production) the site and functions share one origin
VITE_API_BASE_URL=
VITE_CHAT_API_URL=
# Switches. The chat widget is hidden unless true (it needs Anthropic credit).
VITE_CHAT_ENABLED=false
# The footer newsletter form is hidden unless true: subscribing needs MJ_APIKEY_PUBLIC,
# MJ_APIKEY_PRIVATE and MJ_LIST_ID above (otherwise it answers 503). The marketing checkbox
# of /contact and /demande-inspection is always shown and uses the same double opt-in.
VITE_NEWSLETTER_ENABLED=false
